# Parallel ADHD deployment. Copy this file to a private env file and replace
# the password placeholder before starting the stack.
COMPOSE_PROJECT_NAME=horolog-adhd
POSTGRES_PASSWORD=replace-with-a-separate-adhd-database-password

HOROLOG_WEB_PORT=3200
HOROLOG_WEB_BIND_ADDRESS=192.168.1.84
HOROLOG_API_BIND_ADDRESS=127.0.0.1
HOROLOG_API_PORT=8200

# Use the same Ollama endpoint and model as the standard Horolog installation.
HOROLOG_LLM_BASE_URL=http://192.168.1.74:11434/v1
HOROLOG_LLM_API_KEY=ollama
HOROLOG_LLM_MODEL=qwen3:8b
HOROLOG_LLM_TIMEOUT_S=120

HOROLOG_CORS_ORIGINS=["http://192.168.1.84:3200"]
HOROLOG_PUBLIC_API_URL=http://192.168.1.84:8200
HOROLOG_PUBLIC_WEB_URL=http://192.168.1.84:3200

NEXT_PUBLIC_HOROLOG_EXPERIENCE=adhd
HOROLOG_CALENDAR_WRITEBACK_ENABLED=false
